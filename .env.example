# Gravequit Frontend Environment Variables
# Copy this file to .env and replace the values with your actual config.
# DO NOT COMMIT YOUR REAL .env FILE TO GIT!

# The base URL of the Gravequit backend API.
# During local development with docker-compose, this can point to the backend container (e.g. http://localhost:8000).
# In production, this must point to the deployed backend on Render (e.g. https://gravequit-backend.onrender.com).
VITE_API_BASE="http://localhost:8000"
