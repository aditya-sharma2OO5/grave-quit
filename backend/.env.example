# Gravequit Backend Environment Variables
# Copy this file to .env and replace the values with your actual keys.
# DO NOT COMMIT YOUR REAL .env FILE TO GIT!

# Postgres Database connection string (e.g., from Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/gravequit"

# Groq API Key for the LangGraph AI Pipeline (get from console.groq.com)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Secret key used to protect the /admin/retrain endpoint (Dev B / Dev C)
ADMIN_API_KEY="your_super_secret_admin_key"

# Google OAuth Client ID for "Continue with Google" sign-in
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

